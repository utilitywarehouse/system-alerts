# PROMETHEUS RULES
# DO NOT REMOVE line above, used in `pre-commit` hook

groups:
  - name: pubsub-msk
    rules:
      - alert: MSKStalledConsumerGroup
        # per-partition lag over 100k with 0 consumer group members (aggregated across all
        # exporter replicas, so a stale/rolled-over replica can't fake a zero) for the last
        # 3 days, i.e. an orphaned/abandoned group rather than a slow one. Excludes
        # MirrorMaker2-managed groups (tracked via
        # kafka_connect_mirror_mirrorcheckpointconnector_checkpoint_latency_ms) and their
        # same-name-with-source-prefix duplicates, plus any group on a topic MM2 is still
        # actively mirroring (existence of kafka_connect_mirror_mirrorsourceconnector_record_count
        # for the topic, not its rate, since produce traffic on a topic can go quiet for
        # hours without the mirroring having actually stopped), since the checkpoint
        # connector metric alone can lag or drop a group while its topic is still being
        # migrated.
        expr: |
          sum by (kubernetes_cluster, kubernetes_namespace, consumergroup, topic) (
            kafka_consumergroup_lag{app_kubernetes_io_component="msk-metrics"} > 100000
            and on(kubernetes_cluster, kubernetes_namespace, consumergroup) (
              max by (kubernetes_cluster, kubernetes_namespace, consumergroup) (
                max_over_time(kafka_consumergroup_members{app_kubernetes_io_component="msk-metrics"}[3d])
              ) == 0
            )
          )
          unless on(consumergroup) (
            label_replace(
              group by (group) (kafka_connect_mirror_mirrorcheckpointconnector_checkpoint_latency_ms),
              "consumergroup", "$1", "group", "(.*)"
            )
            or
            label_join(
              group by (source, group) (kafka_connect_mirror_mirrorcheckpointconnector_checkpoint_latency_ms),
              "consumergroup", ".", "source", "group"
            )
          )
          unless on(topic) (
            group by (topic) (kafka_connect_mirror_mirrorsourceconnector_record_count)
          )
        for: 6h
        labels:
          team: infra
          group: kafka
        annotations:
          summary: "Consumer group {{ $labels.consumergroup }} on topic {{ $labels.topic }} in cluster {{ $labels.kubernetes_cluster }} has {{ $value }} lag with no members for at least 3 days"
          runbook: "Check with the team owning the consumer group whether it's still needed, and remove it if not. Non source-prefixed groups created during an MSK migration can be removed once their source-prefixed counterpart is confirmed to be the one in active use."
          dashboard: "https://kafka-ui.$ENVIRONMENT.uw.systems/ui/clusters/shared-msk/consumer-groups/{{ $labels.consumergroup }}"
          priority: P2
