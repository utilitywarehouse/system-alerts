# PROMETHEUS RULES
# DO NOT REMOVE line above, used in `pre-commit` hook

groups:
  - name: EqdbLoader
    rules:
      # eqdb-loader only runs inside an operational window (04:00-20:00
      # Europe/London at the time of writing). A load caught by the window closing
      # is stopped and not resumed, so its data is missing until the next in-window
      # trigger.
      - alert: EqdbLoaderWindowExceeded
        expr: "(increase(eqdb_loader_window_exceeded_total[1h]) > 0) * on (namespace) group_left(team) uw_namespace_oncall_team"
        labels:
          alerttype: stock
          alertgroup: eqdb_loader
        annotations:
          summary: "eqdb-loader load in {{ $labels.namespace }} was stopped before completing"
          impact: "Its data is missing, and it will not resume until the next run inside the loading window."
          action: "Check whether the load started too late or the table set no longer fits in the window; adjust the schedule or split the table set. See the `ALERT` line in the loader logs."
          logs: 'https://grafana.${ENVIRONMENT}.aws.uw.systems/explore?left=["now-24h","now","Loki",{"expr":"{kubernetes_cluster=\"{{ $labels.kubernetes_cluster }}\",kubernetes_namespace=\"{{ $labels.namespace }}\"} |= \"ALERT: operational window ended\""}]'
